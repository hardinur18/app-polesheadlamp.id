VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_ANON_KEY=your-public-anon-key
VITE_FUNCTIONS_BASE_URL=https://your-project-ref.supabase.co/functions/v1/make-server-f781cd00
# Optional smoke-test only. Never commit real values here.
# SMOKE_BASE_URL=http://localhost:5174
# SMOKE_SUPABASE_URL=https://your-project-ref.supabase.co
# SMOKE_SUPABASE_ANON_KEY=your-public-anon-key
# SMOKE_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SMOKE_OWNER_EMAIL=owner@example.com
# SMOKE_OWNER_PASSWORD=owner-password
# SMOKE_ROLE_ACCOUNTS={"Owner":{"email":"...","password":"..."},"CS":{"email":"...","password":"..."},"Teknisi":{"email":"...","password":"..."},"Finance":{"email":"...","password":"..."},"Advertiser":{"email":"...","password":"..."}}
# SMOKE_PROSPECT_ACCOUNT={"email":"cs@example.com","password":"...","id":"optional-profile-id"}
# Default jangka panjang: frontend ambil live Meta lewat backend/function, bukan token langsung di browser.
# Optional local-only fallback for live Meta development. Do not put production secrets in committed files.
# Aktifkan hanya kalau Anda memang sedang debug lokal dan belum punya backend token yang aktif.
# VITE_META_DIRECT_FALLBACK=true
# VITE_META_ACCESS_TOKEN=your-local-meta-token
# VITE_META_GRAPH_VERSION=v23.0
# Messenger/IG DM lane idealnya tetap dibaca server-side.
# META_DM_USER_TOKEN=your-facebook-login-for-business-token
# META_IG_ACCESS_TOKEN=your-instagram-long-lived-token
# Google Ads live integration berjalan server-side di Supabase Edge Functions.
# Tidak perlu expose OAuth refresh token, developer token, atau secret Google Ads ke frontend.
# TikTok Ads live integration juga dijalankan server-side lewat Supabase Edge Functions.
# Jangan expose TIKTOK_APP_SECRET atau access token TikTok ke frontend.
