SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-secret-or-service-role-key
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres
# Untuk jangka panjang, isi dengan token Meta server-side yang tidak dipakai langsung di browser.
# Idealnya gunakan token yang dikelola khusus untuk backend, bukan token Graph API Explorer di frontend.
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_ACCESS_TOKEN=your-meta-user-or-system-user-token
META_DM_USER_TOKEN=your-long-lived-facebook-dm-token
META_IG_ACCESS_TOKEN=your-instagram-long-lived-token
META_IG_USER_ID=your-instagram-user-id
META_IG_ACCOUNT_ID=your-instagram-account-id
META_IG_USERNAME=your-instagram-username
META_GRAPH_VERSION=v23.0
META_BATCH_SIZE=50
META_MESSAGING_VERIFY_TOKEN=replace-with-long-random-shared-secret
# --- Kirimdev WhatsApp provider (server-side only, never expose to the browser) ---
# API key for the Kirimdev List Messages API (format: kdv_live_...). Bearer auth.
KIRIMDEV_API_KEY=kdv_live_your-kirimdev-api-key
# WhatsApp Business phone_number_id registered in Kirimdev (public Meta identifier).
KIRIMDEV_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
# Optional human-friendly display number, e.g. 628xxxxxxxxxx.
KIRIMDEV_DISPLAY_PHONE_NUMBER=
# Webhook signing secret(s) from Kirimdev. Comma-separate to rotate without downtime.
# REQUIRED: the kirimdev webhook fails closed (rejects) when this is empty.
KIRIMDEV_WEBHOOK_SECRET=replace-with-kirimdev-signing-secret
# Optional overrides.
KIRIMDEV_API_BASE_URL=https://api.kirimdev.com/v1
KIRIMDEV_WEBHOOK_TOLERANCE_SECONDS=300
GOOGLE_ADS_API_VERSION=v22
GOOGLE_ADS_DEVELOPER_TOKEN=your-google-ads-developer-token
GOOGLE_ADS_CLIENT_ID=your-google-oauth-client-id
GOOGLE_ADS_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_ADS_REFRESH_TOKEN=your-google-oauth-refresh-token
# Optional: manager / MCC customer id untuk akses child accounts.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Optional: batasi customer yang dipakai live breakdown dengan daftar comma-separated.
GOOGLE_ADS_CUSTOMER_IDS=
TIKTOK_API_VERSION=v1.3
TIKTOK_APP_ID=your-tiktok-app-id
TIKTOK_APP_SECRET=your-tiktok-app-secret
TIKTOK_REDIRECT_URI=https://polesheadlamp.id/
