{
  "name": "polesheadlamp-id",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "module:new": "node scripts/create-operational-module.mjs",
    "dependency:health": "node scripts/check-dependency-health.mjs",
    "smoke:routes": "node scripts/smoke-route-navigation.mjs",
    "smoke:role-routes": "node scripts/smoke-role-routes.mjs",
    "perf:mobile-baseline": "node scripts/perf-mobile-baseline.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "typecheck:stock": "tsc --noEmit -p tsconfig.typecheck.stock.json",
    "typecheck:finance": "tsc --noEmit -p tsconfig.typecheck.finance.json",
    "typecheck:orders": "tsc --noEmit -p tsconfig.typecheck.orders.json",
    "typecheck:ads": "tsc --noEmit -p tsconfig.typecheck.ads.json",
    "typecheck:technicians": "tsc --noEmit -p tsconfig.typecheck.technicians.json",
    "typecheck:full": "tsc --noEmit",
    "ads:google-oauth-token": "node scripts/google-ads-oauth-token.mjs",
    "ads:google-snapshot-refresh": "node scripts/google-ads-snapshot-refresh.mjs",
    "meta:ig-refresh": "node scripts/meta-ig-refresh.mjs",
    "meta:ig-refresh:auto": "node scripts/meta-ig-refresh.mjs --env-file .env.supabase.local --mirror-env supabase/functions/.env.local --write-env --sync-supabase --min-valid-days 21",
    "meta:ig-refresh:live": "node scripts/meta-ig-refresh.mjs --env-file .env.supabase.local --mirror-env supabase/functions/.env.local --write-env --sync-supabase",
    "meta:ig-refresh:server": "node scripts/meta-ig-refresh.mjs --no-env-file --state-key meta:instagram:token:rhi-system --sync-state --sync-supabase --min-valid-days 21",
    "meta:system-user-token": "node scripts/meta-system-user-token.mjs",
    "meta:messaging-assets": "node scripts/meta-messaging-assets.mjs",
    "meta:role-dm-token": "node scripts/meta-role-dm-token.mjs",
    "meta:role-wa-token": "node scripts/meta-role-wa-token.mjs",
    "meta:wa-webhook-subscribe": "node scripts/meta-wa-webhook-subscribe.mjs",
    "supabase:deploy:server": "npx supabase functions deploy make-server-f781cd00 --project-ref ${SUPABASE_PROJECT_REF:?Set SUPABASE_PROJECT_REF before deploying from v2}",
    "supabase:deploy:meta-webhook": "npx supabase functions deploy meta-messaging-webhook --project-ref ${SUPABASE_PROJECT_REF:?Set SUPABASE_PROJECT_REF before deploying from v2} --no-verify-jwt",
    "supabase:deploy:kirimdev-webhook": "npx supabase functions deploy kirimdev-messaging-webhook --project-ref ${SUPABASE_PROJECT_REF:?Set SUPABASE_PROJECT_REF before deploying from v2} --no-verify-jwt"
  },
  "dependencies": {
